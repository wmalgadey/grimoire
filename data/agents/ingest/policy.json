{
  "version": 2,
  "defaultDecision": "deny",
  "read": [
    { "pathPrefix": "index.md" },
    { "pathPrefix": "log.md" },
    { "pathPrefix": "." }
  ],
  "write": [
    { "pathPrefix": "index.md" },
    { "pathPrefix": "log.md" },
    { "pathPrefix": ".", "excludePrefixes": ["index.md", "log.md"] }
  ]
}
