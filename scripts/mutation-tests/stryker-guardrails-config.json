{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker-net/master/src/Stryker.Core/Stryker.Core/Schemas/stryker-config.schema.json",
  "stryker-config": {
    "project": "Grimoire.AgentRuntime.csproj",
    "mutate": [
      "**/Guardrails/*.cs",
      "**/Guardrails/Coordination/*.cs"
    ],
    "reporters": [
      "json",
      "cleartext",
      "progress"
    ],
    "thresholds": {
      "high": 90,
      "low": 80,
      "break": 0
    },
    "ignore-methods": [
      "*Exception.ctor"
    ],
    "additional-timeout": 30000,
    "break-on-initial-test-failure": false
  }
}