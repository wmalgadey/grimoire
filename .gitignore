.DS_Store

# spec-kit
.specify/presets/.cache
.specify/extensions/.cache

# .NET
bin/
obj/
*.user
*.suo
.vs/
*.rsuser
*.DotSettings.user
packages/
# Mutation-testing output (Stryker.NET / StrykerJS) — see scripts/mutation-test.sh.
# Generated reports are a local artefact, never a committed one: a full run writes tens of
# megabytes of self-contained HTML. docs/reports/README.md explains how to get them.
StrykerOutput/
.stryker-tmp/
docs/reports/mutation/

# Frontend
node_modules/
src/frontend/dist/
# `svelte-kit sync` output. Unanchored: it lands in frontend/ for a normal build, but in
# the repo root whenever the sync is run from there — that root copy is what leaked into
# git once, and it embeds the machine's $env/static/private variable names.
.svelte-kit/

# Python (scripts/ci/*.py, run via pytest)
__pycache__/
.pytest_cache/
*.pyc

# General
Thumbs.db
*.tmp
*.swp
*.log
.env

# IDE
#.vscode/
.idea/

# Runtime data directory (ADR-022) — harness runtime state and, by default, the agent
# runtime: raw intake, operational state, write-locks, and the agent build output
# (worker binaries + Instructions/, populated by PublishAgentRuntime). Entirely git-ignored:
# it is either build output or working state, never source. Instruction files now live as
# agent-project sources (backend/src/Grimoire.*Agent/Instructions/), tracked there instead.
.grimoire/

# Default wiki directory (ADR-022) — a sibling of .grimoire/, holding wiki content only
# (index.md, log.md, topical article subfolders). Git-ignored by default in this
# repository (a dev/example checkout, not one that ships tracked wiki content); an
# operator who wants their own wiki version-controlled points --wiki-dir at a location
# outside this ignore rule or adds their own tracked repo there.
llm-wiki/

# Default memory directory (022-memory-directory-root, ADR-024) — a sibling of
# .grimoire/ and llm-wiki/, holding agent process bookkeeping (tasks/, conversations/,
# findings/, remediation-tasks/) apart from the wiki content. Git-ignored for the same
# reason as llm-wiki/ above.
memory/

# dotnet test output (results.trx etc.), not build artifacts (bin/obj already covered above)
TestResults/

# Local measurement output (scripts/mutation-tests/). Regenerated by running the scripts;
# the durable records are the issues and, once a feature exists, specs/<feature>/research.md.
artifacts/

# Generated eval fixture (026-guarded-tool-surface T005): `lint-at-scale` is materialized
# on demand by LintAtScaleFixture from `lint-seeded-defects` plus deterministic filler.
# plan.md § Eval scope forbids committing a corpus — the generator is the reviewed
# artifact, its output is not source.
backend/tests/Grimoire.AgentEvals/Fixtures/lint-at-scale/
