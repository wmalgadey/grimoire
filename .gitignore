.DS_Store

# spec-kit
.specify/presets/.cache
.specify/extensions/.cache

# .NET
bin/
obj/
*.user
*.suo
.vs/
*.rsuser
*.DotSettings.user
packages/

# Frontend
node_modules/
src/frontend/dist/

# Python (scripts/ci/*.py, run via pytest)
__pycache__/
.pytest_cache/
*.pyc

# General
Thumbs.db
*.tmp
*.swp
*.log
.env

# IDE
#.vscode/
.idea/

# Runtime data directory (ADR-022) — harness runtime state and, by default, the agent
# runtime: raw intake, operational state, write-locks, and the agent build output
# (worker binaries + Instructions/, populated by PublishAgentRuntime). Entirely git-ignored:
# it is either build output or working state, never source. Instruction files now live as
# agent-project sources (backend/src/Grimoire.*Agent/Instructions/), tracked there instead.
.grimoire/

# Default wiki directory (ADR-022) — a sibling of .grimoire/, holding wiki content only
# (index.md, log.md, topical article subfolders). Git-ignored by default in this
# repository (a dev/example checkout, not one that ships tracked wiki content); an
# operator who wants their own wiki version-controlled points --wiki-dir at a location
# outside this ignore rule or adds their own tracked repo there.
llm-wiki/

# Default memory directory (022-memory-directory-root, ADR-024) — a sibling of
# .grimoire/ and llm-wiki/, holding agent process bookkeeping (tasks/, conversations/,
# findings/, remediation-tasks/) apart from the wiki content. Git-ignored for the same
# reason as llm-wiki/ above.
memory/

# dotnet test output (results.trx etc.), not build artifacts (bin/obj already covered above)
TestResults/
