# Consolidated internal runtime data directory (ADR-009). data/.env is already covered by
# the .env pattern above; data/agents/ (instructions) is git-tracked deliberately.

# Hub operational state (ADR-003)
data/state/
data/raw/

# Conversation Records (011-query-conversations, ADR-014/ADR-003/ADR-009) — Hub-written
# operational harness bookkeeping, one append-only file per conversation. Anchored at
# the base directory as a sibling of the wiki content root (014-wiki-storage-restructure).
conversations/

# Write-coordination lock files (012-query-synthesis-writes, ADR-015/ADR-003/ADR-009) —
# operational bookkeeping for cross-process write coordination, outside wiki/ and git.
data/write-locks/

# Findings Reports (013-lint-agent, ADR-009/ADR-003) — Hub-written operational harness
# bookkeeping, one file per Lint Run, outside wiki/ and git.
data/findings/

# Task artifacts (014-wiki-storage-restructure, ADR-009/ADR-003) — Hub-written operational
# harness bookkeeping, one directory per Task; anchored at the base directory as a sibling
# of the wiki content root (previously nested inside wiki/, uncovered by this file).
tasks/

# Remediation Task Records (015-lint-board-parity, ADR-009/ADR-003/ADR-014) — Hub-written
# operational harness bookkeeping, one append-only file per remediation action task;
# anchored at the base directory as a sibling of the wiki content root.
remediation-tasks/

# dotnet test output (results.trx etc.), not build artifacts (bin/obj already covered above)
TestResults/
