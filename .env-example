ANTHROPIC_AUTH_TOKEN=sk-ant-oat01

# Each agent resolves its own model, and inherits from no other one (ADR-004). All three
# are required: there is no code-level default, so an unset variable fails that agent's
# runs loudly at startup rather than quietly running a model and a price tier nobody chose
# (#117 FR-001).
#
# Precedence for every GRIMOIRE_* variable below, for all three agents alike (#61): this
# file wins; a variable left unset here falls back to whatever the Hub's own process
# environment carries (a shell before `dotnet run`, a launch profile's `env` block); and
# with neither set the agent uses its own default, or fails where the variable is required.
# The Hub logs which source each agent's value came from, and says so when a value set in
# its environment lost to one set here — `agent.env.override_applied` and
# `agent.env.override_superseded`.
GRIMOIRE_INGEST_MODEL="claude-haiku-4-5"
GRIMOIRE_QUERY_MODEL="claude-haiku-4-5"
GRIMOIRE_LINT_MODEL="claude-haiku-4-5"

# GRIMOIRE_INGEST_BASE_URL="https://api.anthropic.com"
# GRIMOIRE_QUERY_BASE_URL="https://api.anthropic.com"
# GRIMOIRE_LINT_BASE_URL="https://api.anthropic.com"

# Per-request output ceiling, per agent (#122). Optional — unset leaves the adapter's own
# default. This is an enforced cap the model does not know about: a turn that reaches it is
# truncated mid-thought and comes back as stop_reason=max_tokens, which costs another turn.
# Raise it for an agent that writes long pages; keep it within what the configured model
# can actually emit, or the provider rejects the request outright.
# GRIMOIRE_INGEST_MAX_OUTPUT_TOKENS=8192
# GRIMOIRE_QUERY_MAX_OUTPUT_TOKENS=8192
# GRIMOIRE_LINT_MAX_OUTPUT_TOKENS=8192

GRIMOIRE_INGEST_TOKEN_CAP=1000000

NVIDIA_API_KEY=nvapi-
NVIDIA_MODEL=minimaxai/minimax-m3

# Agent evals against the affordable NVIDIA NIM provider (feature 007), via the project's
# LiteLLM proxy (scripts/nim/run-litellm-proxy.sh + scripts/nim/litellm_config.yaml).
# Start the proxy first, then set these three to run `dotnet test backend/tests/Grimoire.AgentEvals`
# without an Anthropic subscription. See specs/007-eval-tests-nim-endpoint/quickstart.md.
# `dotnet run --project backend/src/Grimoire.EvalRunner -- capture` also reads this file
# directly (data/.env) for any of these that aren't already set in your shell — no export
# needed locally. CI/production never have this file, so this is a no-op there.
# GRIMOIRE_EVAL=1
# GRIMOIRE_EVAL_PROVIDER_BASE_URL="http://localhost:4000"
# GRIMOIRE_EVAL_PROVIDER_MODEL="nvidia-model"
# GRIMOIRE_EVAL_PROVIDER_API_KEY="${NVIDIA_API_KEY}"

# Recorded-replay eval seam (feature 009, ADR-012): the Grimoire.IngestAgent composition
# root selects the model adapter from these. Production leaves BOTH unset. Setting both
# at once is a fail-fast configuration error. Normally only the EvalRunner sets these,
# per spawned sample — they are documented here for manual diagnosis only.
# GRIMOIRE_MODEL_REPLAY_PATH="/path/to/sample-01.json"   # replay a recording, no credential needed
# GRIMOIRE_MODEL_CAPTURE_PATH="/path/to/sample-01.json"  # capture live turns to a recording
