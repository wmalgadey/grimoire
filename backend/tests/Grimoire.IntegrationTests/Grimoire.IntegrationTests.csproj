<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <!-- 023-task-ui-improvements T001: FakeTimeProvider (namespace
         Microsoft.Extensions.Time.Testing) drives the reactivation backoff schedule on
         virtual time — a concrete fake for a BCL abstraction, not a mocking framework. -->
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="OpenTelemetry.Exporter.InMemory" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Analysis remediation: process-wide ActivitySource/Meter listener state and real
         child-process spawns make cross-test-class parallelism non-deterministic here
         (Constitution II). xunit.runner.visualstudio only honors this via config, not the
         assembly-level [CollectionBehavior] attribute, when run through `dotnet test`. -->
    <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- 019-fast-test-tier (ADR-021, research.md R4): every file in this project can call
         PollAsync's static methods without a per-file `using`. -->
    <Using Include="Grimoire.IntegrationTests.TestSupport" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Grimoire.Hub\Grimoire.Hub.csproj" />
    <ProjectReference Include="..\..\src\Grimoire.Domain\Grimoire.Domain.csproj" />
    <ProjectReference Include="..\..\src\Grimoire.IngestAgent\Grimoire.IngestAgent.csproj" />
    <ProjectReference Include="..\..\src\Grimoire.AgentRuntime\Grimoire.AgentRuntime.csproj" />
    <ProjectReference Include="..\..\src\Grimoire.QueryAgent\Grimoire.QueryAgent.csproj" />
    <ProjectReference Include="..\..\src\Grimoire.LintAgent\Grimoire.LintAgent.csproj" />
    <ProjectReference Include="..\Grimoire.AgentEvals\Grimoire.AgentEvals.csproj" />
    <ProjectReference Include="..\Grimoire.EvalRunner\Grimoire.EvalRunner.csproj" />
    <!-- T013 (012-query-synthesis-writes): the real multi-process CrossProcessFileLock
         test spawns this tiny console harness twice via `dotnet <dll>`; the project
         reference makes its output DLL land in this test project's own output
         directory (same idiom as the ArchTests -> IntegrationTests reference above). -->
    <ProjectReference Include="..\Grimoire.WriteLockTestHarness\Grimoire.WriteLockTestHarness.csproj" />
  </ItemGroup>

</Project>
