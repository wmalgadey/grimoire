    <ProjectReference Include="..\..\src\Grimoire.QueryAgent\Grimoire.QueryAgent.csproj" />
    <ProjectReference Include="..\Grimoire.AgentEvals\Grimoire.AgentEvals.csproj" />
    <ProjectReference Include="..\..\src\Grimoire.EvalRunner\Grimoire.EvalRunner.csproj" />
  </ItemGroup>

