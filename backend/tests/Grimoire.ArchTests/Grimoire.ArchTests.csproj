<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- Explicit, not just transitive via NetArchTest.Rules: 15 files in this project
         import Mono.Cecil directly for IL call-site scanning (see ArchScan.cs). -->
    <PackageReference Include="Mono.Cecil" />
    <PackageReference Include="NetArchTest.Rules" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Grimoire.Hub\Grimoire.Hub.csproj" />
    <ProjectReference Include="..\..\src\Grimoire.Domain\Grimoire.Domain.csproj" />
    <ProjectReference Include="..\..\src\Grimoire.IngestAgent\Grimoire.IngestAgent.csproj" />
    <ProjectReference Include="..\Grimoire.EvalRunner\Grimoire.EvalRunner.csproj" />
    <ProjectReference Include="..\..\src\Grimoire.AgentRuntime\Grimoire.AgentRuntime.csproj" />
    <ProjectReference Include="..\..\src\Grimoire.QueryAgent\Grimoire.QueryAgent.csproj" />
    <ProjectReference Include="..\..\src\Grimoire.LintAgent\Grimoire.LintAgent.csproj" />
    <ProjectReference Include="..\Grimoire.AgentEvals\Grimoire.AgentEvals.csproj" />
    <!-- N1 (ADR-013) scans the shared test assemblies by reference analysis; the
         project reference makes Grimoire.IntegrationTests loadable from this test's
         output directory (same idiom as the Grimoire.AgentEvals reference above). -->
    <ProjectReference Include="..\Grimoire.IntegrationTests\Grimoire.IntegrationTests.csproj" />
    <!-- ADR-021 (019-fast-test-tier): DeterministicTierNoFixedWaitRuleTests also scans
         Grimoire.Domain.UnitTests, which nothing here previously referenced. -->
    <ProjectReference Include="..\Grimoire.Domain.UnitTests\Grimoire.Domain.UnitTests.csproj" />
  </ItemGroup>

</Project>
