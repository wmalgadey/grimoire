<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Grimoire.Domain\Grimoire.Domain.csproj" />
    <ProjectReference Include="..\Grimoire.AgentRuntime\Grimoire.AgentRuntime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenTelemetry" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- ADR-022: marks this project as an agent whose build output is delivered whole
         into <GrimoireAgentDir>/lint/ by backend/Directory.Build.targets. -->
    <GrimoireAgentId>lint</GrimoireAgentId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Instruction files are project sources (ADR-007/ADR-022): the only authoritative
         copies, versioned with the agent and copied to $(OutDir)\Instructions\ on every
         build, from where PublishAgentRuntime delivers them to the agent directory. -->
    <Content Include="Instructions\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
