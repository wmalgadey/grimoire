{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // Grimoire:Paths — single runtime path composition point (ADR-022,
  // docs/adr/ADR-022-minimal-directory-configuration-surface.md). This file is the SOLE
  // source of default paths — there is no code-level fallback (FR-005). Every key below
  // must be present and non-empty; DataDir/WikiDir/AgentDir are also the only three
  // exposed on the command line (--data-dir/--wiki-dir/--agent-dir). Precedence per
  // option: command line > environment (Grimoire__Paths__*) > this file.
  //
  // A relative value below is NEVER resolved against this file's own location or the
  // Hub's install/assembly directory — it resolves against the anchor documented per
  // key (GrimoirePathResolver.Resolve): DataDir/WikiDir/AgentDir/SecretsFile all anchor
  // at the process's current working directory (wherever the operator launched `dotnet
  // Grimoire.Hub.dll` from), each independently — relocating one never drags another
  // along. Every other key anchors at the already-resolved DataDir or WikiDir, as noted.
  "Grimoire": {
    "Paths": {
      // Anchor: process working directory.
      "DataDir": ".grimoire",
      // Anchor: process working directory (independent of DataDir — never nested inside it).
      "WikiDir": "llm-wiki",
      // Anchor: process working directory, independent of DataDir — relocating --data-dir
      // does NOT move the agent runtime with it. The default value is spelled out in full
      // (".grimoire/agents") rather than a bare "agents" precisely because there is no
      // implicit DataDir-nesting to lean on any more.
      "AgentDir": ".grimoire/agents",

      // The three below anchor at the resolved DataDir.
      "RawDir": "raw",
      "StateDb": "state/operational-state.db",
      "WriteLocksDir": "write-locks",

      // The four below anchor at the resolved WikiDir — agent-produced output.
      "TasksDir": "tasks",
      "ConversationsDir": "conversations",
      "FindingsDir": "findings",
      "RemediationTasksDir": "remediation-tasks",

      // Anchor: process working directory, independent of the three roots above —
      // relocating DataDir/WikiDir/AgentDir never separates an operator from credentials.
      "SecretsFile": ".env"
    }
  }
}
