<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Grimoire.Domain\Grimoire.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The root-help Figlet font (HubCliHelpProvider). Embedded rather than copied to the
         output directory so the help path never depends on a file being present on disk:
         it is contractually guaranteed to render before any path resolution happens. -->
    <EmbeddedResource Include="Cli\Fonts\dos-rebel.flf" LogicalName="Grimoire.Hub.Cli.Fonts.dos-rebel.flf" />
    <!-- The wiki-identity wizard's drafting brief (WikiIdentityDraftingBrief) — kept as an
         editable markdown file rather than a C# string literal, same reasoning as the font
         above: it is product wording, not logic, and this is easier to review and edit. -->
    <EmbeddedResource Include="WikiIdentity\DraftingBrief.md" LogicalName="Grimoire.Hub.WikiIdentity.DraftingBrief.md" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <!-- Rendering (FigletText/Markup/Align/Grid in HubCliHelpProvider, CliStatusRenderer)
         and command-line parsing are two packages; both are used directly here. -->
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="Spectre.Console.Cli" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
    <PackageReference Include="OpenTelemetry" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
  </ItemGroup>

</Project>
